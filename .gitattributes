# Line endings ---------------------------------------------------------------
* text=auto

*.sh    text eol=lf
*.neon  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf

# Dist contents ---------------------------------------------------------------
# Everything below is stripped from the GitHub archive, which is what
# `composer install --prefer-dist` downloads. A consumer needs the stub files,
# composer.json, the LICENSE and the README -- nothing else here is read at
# install time, and the generation tooling is only useful inside a git clone.
/.editorconfig              export-ignore
/.gitattributes             export-ignore
/.github                    export-ignore
/.gitignore                 export-ignore
/.idea                      export-ignore
/.travis.yml                export-ignore
/.vscode                    export-ignore
/bin                        export-ignore
/configs                    export-ignore
/docs                       export-ignore
/lib                        export-ignore
/phpcs.xml                  export-ignore
/phpcs.xml.dist             export-ignore
/phpstan.neon               export-ignore
/phpunit.xml                export-ignore
/phpunit.xml.dist           export-ignore
/source                     export-ignore
/tests                      export-ignore
/bootstrap.php              export-ignore
/finder.php                 export-ignore
/finder-packages.php        export-ignore
/git_tags_backup.txt        export-ignore
*_versions.txt              export-ignore
*_processing_history.txt    export-ignore
